+test.describe("booking form before the page has hydrated", () => {
+  // No JavaScript = the same state a visitor is in before the bundle has loaded and React has
+  // attached the submit handler. The server-rendered form is visible but must not be submittable,
+  // otherwise the browser falls back to a native GET and puts the name/phone number in the URL.
+  test.use({ javaScriptEnabled: false });
+
+  test("cannot be submitted natively, so no personal details leak into the URL", async ({
+    page,
+  }) => {
+    await page.goto("/book");
+    await expect(page.getByRole("heading", { name: /Book your visit/i })).toBeVisible();
+    await expect(submit(page)).toBeDisabled();
+
+    await page.getByLabel("Full name").fill("Asha Test");
+    await page.getByLabel("Phone").fill("9147718046");
+    await page.getByLabel("Phone").press("Enter"); // implicit submission is blocked by a disabled default button
+
+    await page.waitForTimeout(500);
+    expect(new URL(page.url()).search).toBe("");
+  });
+});
