# ─────────────────────────────────────────────────────────────
# Elite Dental Clinic (Barasat) — Environment Configuration
# Copy this file to `.env` for local development. NEVER commit `.env`.
# On your deployment host (Cloudflare / Nitro), set matching environment variables.
# ─────────────────────────────────────────────────────────────

# ── Public (Client) ── Safe to expose in the browser bundle (prefixed with VITE_).
# Inlined at build time by Vite.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Canonical production origin (scheme + host only, no path, e.g. https://drdebayansaha.in).
# Drives canonical links, Open Graph tags, /sitemap.xml and /robots.txt.
VITE_SITE_URL=https://drdebayansaha.in

# Optional Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Analytics is disabled when empty.
VITE_GA_ID=

# Optional Cloudflare Turnstile site key for interactive/invisible bot challenge on the booking form.
# Leave empty in local dev to disable Turnstile challenge.
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=


# ── Server Only (Secrets) ── Read at runtime by server routes. NEVER ship to browser.
# DO NOT prefix these with VITE_.

# 1. Server Database Access (REQUIRED for booking creation & admin management)
# The server-side booking endpoint (/api/create-appointment) writes appointments and outbox
# records directly using the Supabase admin client. The service-role key bypasses RLS and
# MUST remain server-only.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 2. Staff Admin Portal Authorization (/admin)
# Comma-separated list of staff email addresses allowed to view patient appointments,
# read clinical notes, update booking statuses, and trigger outbox retries.
# Users must authenticate via Supabase Auth and either match this allowlist or hold role='admin'.
STAFF_EMAILS=drdebayansaha@drdebayansaha.in,clinic.admin@drdebayansaha.in

# 3. Transactional Email Notifications via Resend (Optional for saving bookings, required for emails)
# If Resend is unconfigured or unavailable, appointments are still safely persisted to the database
# and enqueued in the notification outbox table for retry. The patient is never falsely told booking failed.
RESEND_API_KEY=re_your_resend_api_key
NOTIFY_EMAIL=clinic@example.com
NOTIFY_FROM="Elite Dental Clinic <onboarding@resend.dev>"

# 4. Server Security & Bot Verification
# Cloudflare Turnstile secret key for server-side token validation.
TURNSTILE_SECRET_KEY=

# Internal shared secret for administrative operations and cron triggers (/api/retry-notifications).
# Callers must provide header: X-Notify-Secret: <value>
NOTIFY_SECRET=your-secure-internal-shared-secret
